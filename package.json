{
  "name": "fitness-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "lucide-react": "^1.66.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-muscle-highlighter": "^1.2.0"
  },
  "overrides": {
    "@svgr/webpack": "^8.0.1",
    "@adobe/css-tools": "^4.3.1"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,white \"npm:server\" \"npm:start\"",
    "start": "vite --port 3000",
    "server": "node --disable-warning=ExperimentalWarning --watch-path=server --watch-path=src/shared server/index.js",
    "build": "vite build",
    "serve": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "notify": "node --disable-warning=ExperimentalWarning server/notify.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.6",
    "jsdom": "^26.1.0",
    "supertest": "^7.3.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.6"
  }
}
